{
  "version": 3,
  "routes": [
    {
      "src": "/js/(.*)",
      "dest": "/js/$1"
    },
    {
      "src": "/css/(.*)",
      "dest": "/css/$1"
    },
    {
      "src": "/pages/(.*\\.html)",
      "dest": "/pages/$1"
    },
    {
      "src": "/pages/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/(.*\\.html)",
      "dest": "/$1.html"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.js"
    }
  ]
} 