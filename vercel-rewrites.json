[
  { "source": "/api/:path*", "destination": "/src/server.js" },
  { "source": "/api-docs", "destination": "/src/server.js" },
  { "source": "/api-docs/:path*", "destination": "/src/server.js" },
  { "source": "/pages/:path*", "has": [{ "type": "header", "key": "accept", "value": "text/html" }], "destination": "/pages/:path*" },
  { "source": "/js/:path*", "destination": "/js/:path*" },
  { "source": "/css/:path*", "destination": "/css/:path*" },
  { "source": "/:path*", "destination": "/index.html" }
] 